<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Intentionally NOT sandboxed: restic must read arbitrary user paths,
	     spawn as a child process and reach the network. A sandboxed parent
	     would confine the child too. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
